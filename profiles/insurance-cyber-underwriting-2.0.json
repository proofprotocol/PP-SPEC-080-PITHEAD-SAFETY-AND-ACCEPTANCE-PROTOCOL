    "accept_fragmented": false,
    "max_corpus_age_days": 90,
    "rates_across_segments": false,
    "reject_if_undeclared": [
      "control",
      "corpus",
      "harness",
      "pigtail"
    ]
  },
  "authorship_disclosure": {
    "required": true,
    "human_review_required": true,
