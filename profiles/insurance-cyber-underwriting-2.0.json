  },
  "reproof": {
    "min_status": "reproven",
    "scope": "instance",
    "min_independent_checks": 1,
    "max_splitting_limits": {
      "stopped_rate": 0.05,
      "false_block_rate": 0.05
    },
    "on_divergent": "flag",
    "on_disputed": "reject",
    "on_not_upheld": "reject",
    "on_checked_insufficient": "flag",
    "min_umpire_pool": 3,
    "max_comparison_age_days": 180,
    "by_purpose": {
      "renewal": {
        "scope": "either"
      }
    }
